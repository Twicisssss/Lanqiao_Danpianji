  19          /*按键处理区域*/
  20          void Key_Proc()
  21          {
  22   1              if(Key_Slow)return;
  23   1              Key_Slow=1;
  24   1              
  25   1              Key_Val=Key_Read();
  26   1              Key_Down=Key_Val&(Key_Old^Key_Val);
  27   1              Key_Up=~Key_Val&(Key_Old^Key_Val);
  28   1              Key_Old=Key_Val;
  29   1              
  30   1              
  31   1      }
