  71          void Timer0_Init(void)          //1毫秒@12.000MHz
  72          {
  73   1              AUXR &= 0x7F;                   //定时器时钟12T模式
  74   1              TMOD &= 0xF0;                   //设置定时器模式
  75   1              TL0 = 0x18;                             //设置定时初始值
  76   1              TH0 = 0xFC;                             //设置定时初始值
  77   1              TF0 = 0;                                //清除TF0标志
