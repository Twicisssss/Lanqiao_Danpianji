   1          #include <Uart.H>
   2          void Uart1_Init(void)   //9600bps@12.000MHz
   3          {
   4   1              SCON = 0x50;            //8位数据,可变波特率
   5   1              AUXR |= 0x01;           //串口1选择定时器2为波特率发生器
   6   1              AUXR &= 0xFB;           //定时器时钟12T模式
   7   1              T2L = 0xE6;                     //设置定时初始值
   8   1              T2H = 0xFF;                     //设置定时初始值
   9   1              AUXR |= 0x10;           //定时器2开始计时
  10   1              ES = 1;                         //使能串口1中断
  11   1              EA=1;
  12   1      }
  13          void Uart_Send_Byte(unsigned char dat)
  14          {
  15   1              SBUF=dat;
  16   1              while(TI==0);
  17   1              TI=0;
  18   1      }
  19          void Uart_Send_String(unsigned char *dat)
  20          {
  21   1              while(*dat!='\0')
  22   1                      Uart_Send_Byte(*dat++);
  23   1      }
