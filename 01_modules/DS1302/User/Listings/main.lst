  69          void Timer0_Init(void)          //1毫秒@12.000MHz
  70          {
  71   1              AUXR &= 0x7F;                   //定时器时钟12T模式
  72   1              TMOD &= 0xF0;                   //设置定时器模式
  73   1              TL0 = 0x18;                             //设置定时初始值
