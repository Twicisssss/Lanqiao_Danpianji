   6          unsigned char Key_Slow,Key_Val,Key_Old,Key_Down,Key_Up;
   7          unsigned char Seg_Slow,Seg_Pos,Seg_Buf[8]={10,10,10,10,10,10,10,10};
   8          unsigned char Num=0;
   9          
  10          void Key_Proc()
  11          {
  12   1              if(Key_Slow)return;
