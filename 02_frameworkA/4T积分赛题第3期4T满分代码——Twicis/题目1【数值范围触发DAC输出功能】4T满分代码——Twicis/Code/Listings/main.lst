  14   1              
  15   1              Key_Val=Key_Read();
  16   1              Key_Down=Key_Val&(Key_Old^Key_Val);
  17   1              Key_Up=~Key_Val&(Key_Old^Key_Val);
  18   1              Key_Old=Key_Val;
