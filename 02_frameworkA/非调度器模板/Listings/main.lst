 137          void Timer1_Init(void)          //1毫秒@12.000MHz
 138          {
 139   1              AUXR &= 0xBF;                   //定时器时钟12T模式
 140   1              TMOD &= 0x0F;                   //设置定时器模式
 141   1              TL1 = 0x18;                             //设置定时初始值
 142   1              TH1 = 0xFC;                             //设置定时初始值
 143   1              TF1 = 0;                                //清除TF1标志
 144   1              TR1 = 1;                                //定时器1开始计时
 145   1              ET1 = 1;                                //使能定时器1中断
 146   1              EA=1;
 147   1      }
