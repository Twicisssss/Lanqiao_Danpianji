 117          void Timer1_Init(void)          //1毫秒@12.000MHz
 118          {
 119   1              AUXR &= 0xBF;                   //定时器时钟12T模式
 120   1              TMOD &= 0x0F;                   //设置定时器模式
 121   1              TL1 = 0x18;                             //设置定时初始值
 122   1              TH1 = 0xFC;                             //设置定时初始值
 123   1              TF1 = 0;                                //清除TF1标志
