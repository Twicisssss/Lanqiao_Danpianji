   1          #include <Uart.H>
   2          
   3          void Uart1_Init(void)   //9600bps@12.000MHz
   4          {
   5   1              SCON = 0x50;            //8位数据,可变波特率
   6   1              AUXR |= 0x01;           //串口1选择定时器2为波特率发生器
   7   1              AUXR &= 0xFB;           //定时器时钟12T模式
   8   1              T2L = 0xE6;                     //设置定时初始值
   9   1              T2H = 0xFF;                     //设置定时初始值
  10   1              AUXR |= 0x10;           //定时器2开始计时
  11   1              ES = 1;                         //使能串口1中断
  12   1              EA=1;
  13   1      }
  14          
  15          extern char putchar (char ch)
  16          {
  17   1              SBUF=ch;
  18   1              while(TI==0);
  19   1              TI=0;
  20   1              return ch;
  21   1      }
