 246   1              TH1 = 0xFC;                             //设置定时初始值
 247   1              TF1 = 0;                                //清除TF1标志
 248   1              TR1 = 1;                                //定时器1开始计时
 249   1              ET1 = 1;                                //使能定时器1中断
 250   1              EA=1;
 251   1      }
