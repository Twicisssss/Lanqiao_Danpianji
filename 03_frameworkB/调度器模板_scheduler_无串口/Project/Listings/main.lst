 124          /*NE555定时器0区域*/
 125          void NE555_Timer0_Init(void)
 126          {
 127   1              AUXR &= 0x7F;                   //定时器时钟12T模式
 128   1              TMOD &= 0xF0;                   //设置定时器模式
 129   1              TMOD |= 0x05;                   //设置定时器模式
 130   1              TL0 = 0;                                //设置定时初始值
 131   1              TH0 = 0;                                //设置定时初始值
 132   1              TF0 = 0;                                //清除TF0标志
 133   1              TR0 = 1;                                //定时器0开始计时
 134   1      }
 135          /*定时器1区域*/
 136          void Timer1_Init(void)          //1毫秒@12.000MHz
 137          {
 138   1              AUXR &= 0xBF;                   //定时器时钟12T模式
 139   1              TMOD &= 0x0F;                   //设置定时器模式
 140   1              TL1 = 0x18;                             //设置定时初始值
 141   1              TH1 = 0xFC;                             //设置定时初始值
 142   1              TF1 = 0;                                //清除TF1标志
 143   1              TR1 = 1;                                //定时器1开始计时
 144   1              ET1 = 1;                                //使能定时器1中断
 145   1      }
 146          void Timer1_Isr(void) interrupt 3
 147          {       
 148   1              sys_tick++;
 149   1              if(++time_1s_freq==100)
 150   1              {
 151   2                      time_1s_freq=0;
 152   2                      ne555_frequency=(TH0<<8)|TL0;
 153   2                      TH0=TL0=0;
 154   2                      ne555_frequency=ne555_frequency*10;
 155   2              }
 156   1              pwm_count=(++pwm_count)%10;
 157   1              if(pwm_count>pwm_compare)
 158   1                      led_off();
 159   1              else
 160   1                      led_disp(led_buf);
 161   1              
 162   1              seg_pos=(++seg_pos)%8;
 163   1              if(seg_buf[seg_pos]>20)
 164   1                      seg_disp(seg_pos,seg_buf[seg_pos]-',',1);
 165   1              else
 166   1                      seg_disp(seg_pos,seg_buf[seg_pos],0);
 167   1      }
