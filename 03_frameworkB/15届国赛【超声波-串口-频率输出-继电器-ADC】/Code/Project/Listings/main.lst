 405          /*NE555定时器0区域*/
 406          void Timer0_Init(void)          //1毫秒@12.000MHz
 407          {
 408   1              AUXR &= 0x7F;                   //定时器时钟12T模式
 409   1              TMOD &= 0xF0;                   //设置定时器模式
 410   1              TMOD |= 0x05;                   //设置定时器模式
 411   1              TL0 = 0;                                //设置定时初始值
 412   1              TH0 = 0;                                //设置定时初始值
 413   1              TF0 = 0;                                //清除TF0标志
 414   1              TR0 = 1;                                //定时器0开始计时
 415   1      }
 416          /*定时器1区域*/
 417          void Timer1_Init(void)          //1毫秒@12.000MHz
 418          {
 419   1              AUXR &= 0xBF;                   //定时器时钟12T模式
 420   1              TMOD &= 0x0F;                   //设置定时器模式
 421   1              TL1 = 0x18;                             //设置定时初始值
 422   1              TH1 = 0xFC;                             //设置定时初始值
 423   1              TF1 = 0;                                //清除TF1标志
 424   1              TR1 = 1;                                //定时器1开始计时
 425   1              ET1 = 1;                                //使能定时器1中断
 426   1              EA=1;
