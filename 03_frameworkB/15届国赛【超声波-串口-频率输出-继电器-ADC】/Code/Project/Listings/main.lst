 489          typedef struct{
 490                  void(*task_function)(void);
 491                  unsigned long int rate_time;
 492                  unsigned long int last_time;
 493          }Task_Message;
 494          
 495          idata Task_Message schedule_task[]={
 496                  {led_task,1,0},
 497                  {seg_task,200,0},
 498                  {key_task,10,0},
 499                  {uart_task,10,0},
