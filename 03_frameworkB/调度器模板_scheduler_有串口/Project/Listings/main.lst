 165          /*NE555定时器0区域*/
 166          void NE555_Timer0_Init(void)
 167          {
 168   1              AUXR &= 0x7F;                   //定时器时钟12T模式
 169   1              TMOD &= 0xF0;                   //设置定时器模式
 170   1              TMOD |= 0x05;                   //设置定时器模式
 171   1              TL0 = 0;                                //设置定时初始值
 172   1              TH0 = 0;                                //设置定时初始值
