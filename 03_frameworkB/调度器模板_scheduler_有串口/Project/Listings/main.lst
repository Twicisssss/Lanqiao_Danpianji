 177          void Timer1_Init(void)          //1毫秒@12.000MHz
 178          {
C51 COMPILER V9.54   MAIN                                                                  05/11/2025 10:32:19 PAGE 4   

 179   1              AUXR &= 0xBF;                   //定时器时钟12T模式
