 243          idata task_num;
 244          void schedule_init(void)
 245          {
 246   1              task_num=sizeof(TaskSchedule)/sizeof(TaskMessage);
 247   1      }
 248          void schedule_run(void)
 249          {
 250   1              unsigned char i;
 251   1              for(i=0;i<task_num;i++)
 252   1              {
 253   2                      unsigned long int now_time=sys_tick;
