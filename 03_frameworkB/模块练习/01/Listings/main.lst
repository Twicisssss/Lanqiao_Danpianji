 145          void NE555_Timer0_Init(void)//@12.000MHz
 146          {
 147   1              AUXR &= 0x7F;                   //定时器时钟12T模式
 148   1              TMOD &= 0xF0;                   //设置定时器模式
 149   1              TMOD |= 0x05;                   //设置定时器模式
 150   1              TL0 = 0;                                //设置定时初始值
 151   1              TH0 = 0;                                //设置定时初始值
 152   1              TF0 = 0;                                //清除TF0标志
 153   1              TR0 = 1;                                //定时器0开始计时
 154   1      }
 155          /*==========定时器1区域==========*/
 156          void Timer1_Init(void)          //1毫秒@12.000MHz
 157          {
 158   1              AUXR &= 0xBF;                   //定时器时钟12T模式
 159   1              TMOD &= 0x0F;                   //设置定时器模式
 160   1              TL1 = 0x18;                             //设置定时初始值
 161   1              TH1 = 0xFC;                             //设置定时初始值
 162   1              TF1 = 0;                                //清除TF1标志
 163   1              TR1 = 1;                                //定时器1开始计时
 164   1              ET1 = 1;                                //使能定时器1中断
 165   1              EA=1;
 166   1      }
 167          void Timer1_Isr(void) interrupt 3
 168          {
 169   1              sys_tick++;
 170   1              seg_pos=(++seg_pos)%8;
 171   1              if(seg_buf[seg_pos]>=20)
 172   1                      seg_disp(seg_pos,seg_buf[seg_pos]-',',1);
 173   1              else
 174   1                      seg_disp(seg_pos,seg_buf[seg_pos],0);
 175   1              
 176   1              if(++ne555_cycle_1s==100)
 177   1              {
 178   2                      ne555_cycle_1s=0;
C51 COMPILER V9.54   MAIN                                                                  06/14/2025 23:07:28 PAGE 4   

 179   2                      ne555_frequency=TH0<<8|TL0;
 180   2                      TH0=TL0=0;
 181   2                      ne555_frequency=ne555_frequency*10;
 182   2              }
 183   1              
 184   1              if(uart_rx_flag==1)
 185   1                      uart_rx_tick++;
 186   1      }
