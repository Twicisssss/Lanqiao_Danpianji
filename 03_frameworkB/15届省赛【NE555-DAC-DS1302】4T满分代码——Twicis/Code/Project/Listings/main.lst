 241          void NE555_Init(void)           //1毫秒@12.000MHz
 242          {
 243   1              AUXR &= 0x7F;                   //定时器时钟12T模式
 244   1              TMOD &= 0xF0;                   //设置定时器模式
 245   1              TMOD |= 0x05;                   //设置定时器模式
 246   1              TL0 = 0;                                //设置定时初始值
 247   1              TH0 = 0;                                //设置定时初始值
 248   1              TF0 = 0;                                //清除TF0标志
 249   1              TR0 = 1;                                //定时器0开始计时
 250   1      }
 251          /*====================定时器1区域====================*/
 252          void Timer1_Init(void)          //1毫秒@12.000MHz
 253          {
 254   1              AUXR &= 0xBF;                   //定时器时钟12T模式
 255   1              TMOD &= 0x0F;                   //设置定时器模式
 256   1              TL1 = 0x18;                             //设置定时初始值
 257   1              TH1 = 0xFC;                             //设置定时初始值
 258   1              TF1 = 0;                                //清除TF1标志
 259   1              TR1 = 1;                                //定时器1开始计时
 260   1              ET1 = 1;                                //使能定时器1中断
 261   1              EA=1;
 262   1      }
