 307          /*====================调度器区域====================*/
 308          typedef struct{
 309                  void (*task_function)(void);
 310                  unsigned long int rate_time;
 311                  unsigned long int last_time;
 312          }TaskMessage;
 313          idata TaskMessage ScheduleTask[]={
 314                  {key_task,20,0},
 315                  {led_task,1,0},
 316                  {seg_task,200,0},
 317                  {rtc_task,300,0},
 318                  {adda_task,250,0},
 319          };
 320          idata unsigned char task_num;
 321          void schedule_init(void)
 322          {
 323   1              task_num=sizeof(ScheduleTask)/sizeof(TaskMessage);
 324   1      }
 325          void schedule_run(void)
 326          {
 327   1              unsigned char i;
 328   1              for(i=0;i<task_num;i++)
 329   1              {
 330   2                      unsigned long int now_time=sys_tick;
 331   2                      if(now_time>=ScheduleTask[i].rate_time+ScheduleTask[i].last_time)
 332   2                      {
 333   3                              ScheduleTask[i].last_time=now_time;
 334   3                              ScheduleTask[i].task_function();
 335   3                      }
 336   2              }
 337   1      }
